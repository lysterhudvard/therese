---
import '../styles.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	heroImage?: string;
}

const { 
  title = "Therese Järvheden — Skådespelerska", 
  description = "Therese Järvheden — Swedish actress. Drama, comedy, voice. Featured in SVT's 'En våldsam kärlek', 'Karatefylla', Beck — 'Utan uppsåt'.",
  image = "https://a6c2528650.clvaw-cdnwnd.com/a1d4e2b76c0723db65512f7305fc0d9c/200000000-339e8339ea/Thess1114_lowres.jpg?ph=a6c2528650",
  heroImage
} = Astro.props;
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<ClientRouter />
		
    <!-- SEO and Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Therese Järvheden" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://uhdzswnawlqpsaajsjpo.supabase.co" crossorigin />
    <link rel="dns-prefetch" href="https://uhdzswnawlqpsaajsjpo.supabase.co" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter+Tight:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter+Tight:wght@300;400;500;600&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter+Tight:wght@300;400;500;600&display=swap" />
    </noscript>
    
    {heroImage && (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
    )}

    <!-- Bot & Repeat Visitor Intro Bypass -->
    <script is:inline>
      (function() {
        try {
          var isBot = false;
          if (typeof navigator !== 'undefined') {
            var ua = navigator.userAgent || '';
            isBot = /bot|googlebot|crawler|spider|robot|crawling|lighthouse|chrome-lighthouse|gtmetrix|pingdom/i.test(ua) ||
                    !!navigator.webdriver ||
                    !navigator.languages ||
                    (navigator.languages && navigator.languages.length === 0);
          }
          if (typeof window !== 'undefined') {
            isBot = isBot || !!window.Lighthouse || !!window.__lighthouse__;
          }
          var introPlayed = false;
          try {
            if (typeof sessionStorage !== 'undefined' && sessionStorage) {
              introPlayed = sessionStorage.getItem('introPlayed');
            }
          } catch (_) {}
          if (isBot || introPlayed) {
            document.documentElement.classList.add('skip-intro');
          }
        } catch (e) {
          console.error(e);
        }
      })();
    </script>

    <!-- JSON-LD Schema (Person) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Therese Järvheden",
        "jobTitle": "Skådespelerska, Röstskådespelare",
        "description": "Svensk skådespelerska och röstskådespelare baserad i Malmö och Stockholm. Aktuell i SVT:s En våldsam kärlek. Skånsk dialekt.",
        "url": "https://www.theresejarvheden.se",
        "image": "https://a6c2528650.clvaw-cdnwnd.com/a1d4e2b76c0723db65512f7305fc0d9c/200000000-339e8339ea/Thess1114_lowres.jpg?ph=a6c2528650",
        "knowsLanguage": ["sv", "en"],
        "sameAs": [
          "https://www.imdb.com/name/nm5098431/",
          "https://commercialactors.com/en/therese-jarvheden",
          "https://schultzbergagency.com/therese-jarvheden/",
          "https://www.instagram.com/theresejarvheden/",
          "https://www.facebook.com/therese.jarvhedenfdpersson",
          "https://www.lysterhudvard.se"
        ],
        "worksFor": [
          {
            "@type": "Organization",
            "name": "Schultzberg Agency",
            "url": "https://schultzbergagency.com"
          },
          {
            "@type": "Organization",
            "name": "Commercial Actors",
            "url": "https://commercialactors.com"
          }
        ],
        "performerIn": [
          {
            "@type": "TVSeries",
            "name": "En våldsam kärlek",
            "url": "https://www.svtplay.se/en-valdsam-karlek"
          },
          { "@type": "TVSeries", "name": "Karatefylla" },
          { "@type": "TVSeries", "name": "Jävla klåpare" },
          { "@type": "Movie", "name": "Beck – Utan uppsåt" },
          { "@type": "TVSeries", "name": "Kärlek & anarki" }
        ]
      }
    </script>
    <slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
