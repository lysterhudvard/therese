---
import Layout from '../layouts/Layout.astro';
import { Nav } from '../components/Nav';
import { Spotlight } from '../components/ui/Spotlight';
import { FAQ } from '../components/sections/FAQ';
import { PageHeader } from '../components/ui/PageHeader';
import { Footer } from '../components/sections/Footer';
import { CommentaryPlayer } from '../components/ui/CommentaryPlayer';
import { CookieConsent } from '../components/ui/CookieConsent';
import { setGlobalDbData } from '../hooks/use-t';
import { getPageData } from '../lib/supabase-server';

// Fetch the data on the server for instant SSR and SEO injection
const dbData = await getPageData();
let processedDbData = dbData || { biography: {}, credits: [], showreels: [], seo: null, portfolioImages: [] };

setGlobalDbData(processedDbData);

// Basic SEO
const seoTitle = "Vanliga Frågor (FAQ) | Therese Järvheden";
const seoDesc = "Vanliga frågor och svar om skådespelerskan och röstskådespelerskan Therese Järvheden.";
const seoImage = processedDbData.seo?.og_image || "https://a6c2528650.clvaw-cdnwnd.com/a1d4e2b76c0723db65512f7305fc0d9c/200000000-339e8339ea/Thess1114_lowres.jpg?ph=a6c2528650";

// Google FAQ JSON-LD Schema
let faqSchema = null;
const faqsList = processedDbData.biography?.faqs;
if (faqsList && Array.isArray(faqsList) && faqsList.length > 0) {
  const faqItems = faqsList.filter(faq => (faq.q?.sv || faq.q?.en) && (faq.a?.sv || faq.a?.en)).map(faq => ({
    "@type": "Question",
    "name": faq.q?.sv || faq.q?.en,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a?.sv || faq.a?.en
    }
  }));

  if (faqItems.length > 0) {
    faqSchema = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems
    });
  }
}
---

<Layout title={seoTitle} description={seoDesc} image={seoImage}>
  {faqSchema && (
    <script type="application/ld+json" set:html={faqSchema} slot="head" />
  )}
  <script is:inline define:vars={{ processedDbData }}>
    window.__INITIAL_DB_DATA__ = processedDbData;
  </script>
  
  <Spotlight client:media="(min-width: 1024px)" />
  <Nav client:idle />
  
  <div class="min-h-screen pb-20">
    <PageHeader client:idle titleKey="faq" />
    <FAQ client:visible isSubpage={true} faqs={processedDbData?.biography?.faqs} />
  </div>
  
  <Footer client:visible simple={true} />
  <CommentaryPlayer client:idle />
  <CookieConsent client:idle />
</Layout>
